DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Migrations use this instead of DATABASE_URL (see prisma/schema.prisma for
# why) — on Neon, the same connection string but without "-pooler" in the
# hostname. Outside Neon (e.g. local Postgres), just repeat DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname"
AUTH_SECRET="replace-with-output-of: openssl rand -base64 32"

# Optional — member notification emails (approval, import welcome) are
# skipped with a console warning if this isn't set.
RESEND_API_KEY=""
EMAIL_FROM="TEIN-KUC <onboarding@resend.dev>"
SITE_URL="https://www.teinkuc.online"

# Optional — member notification texts (approval, import welcome, password
# reset) are skipped with a console warning if this isn't set. Get an API
# key from https://arkesel.com. SMS_SENDER_ID must be an alphanumeric ID of
# 11 characters or fewer, registered/approved in your Arkesel dashboard.
ARKESEL_API_KEY=""
SMS_SENDER_ID="TEINKUC"
